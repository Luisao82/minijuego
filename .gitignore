# Variables de entorno (secretos locales)
.env

# Claude Code (worktrees locales, no parte del repo)
.claude/worktrees/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.
node_modules
dist
dist-ssr
*.local

# Capacitor Android — trackeamos el proyecto nativo para poder configurar
# manifest, permisos e iconos. Los derivados (build/, .gradle/, keystore local,
# etc.) ya los excluye android/.gitignore. Excluimos aquí el bundle web que
# `cap sync` copia dentro del proyecto, porque se regenera desde `dist/`.
/android/app/src/main/assets/public/
# Keystore de firma NUNCA en git. Guarda una copia segura fuera del repo.
*.keystore
*.jks
android/keystore.properties

# Capacitor iOS — trackeamos el proyecto Xcode porque tenemos código nativo propio
# (MainViewController.swift, overrides de Info.plist). Los derivados los excluye ios/.gitignore.
# Sí excluimos aquí los assets del web bundle sincronizados por `cap sync`, que se regeneran.
/ios/App/App/public/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
